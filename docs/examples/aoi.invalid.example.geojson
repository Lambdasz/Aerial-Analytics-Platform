  "map_image_interaction": {
    "scenario_list_to_map": {
      "input": {
        "action": "focus_map_on_image",
        "payload": {
          "image_id": "drone_001",
          "target_coordinate": { "latitude": -1.234, "longitude": 116.456 },
          "animation": "fly_to",
          "target_zoom_level": 20
        }
      },
      "output": {
        "event": "map_view_updated",
        "source_ui": "leaflet_map_engine",
        "state": {
          "current_center": [-1.234, 116.456],
          "current_zoom": 20,
          "highlighted_marker": "drone_001"
        }
      }
    },
    "scenario_map_to_list": {
      "input": {
        "action": "click_image_marker",
        "payload": {
          "clicked_image_id": "drone_001",
          "coordinate": { "latitude": -1.234, "longitude": 116.456 }
        }
      },
      "output": {
        "event": "image_activated_from_map",
        "source_ui": "leaflet_marker",
        "data": { "active_image_id": "drone_001", "trigger_preview": true }
      }
    }
  },

