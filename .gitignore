# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vs/

# Cargo & Build artifacts
target/
**/target/
plugins/**/bin/

# Full-resolution sample photos and raw drone material: never commit
# these (privacy + repo size).
src-tauri/src/sampel/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class

# Plugin manager runtime state (regenerated by the app)
plugins/plugin_state.json

# Ngeblok hasil run, soale isinya cmn temporary
**/runs/*
!**/runs/.gitkeep
src/map/dummy_image/drone_ortho.png

# Map storage: ignore heavy raw GeoTIFF files, OS lock, jobs, and staging
map_storage/**/*.tif
map_storage/**/*.tiff
map_storage/.app.lock
map_storage/.jobs/
map_storage/**/.staging_*
map_storage/**/.trash_*

map_storage_backup/

# Local SQLite DB (dev-only, created by `run()` in src-tauri/src/lib.rs)
*.db
*.db-journal
*.db-wal
*.db-shm

# Python virtualenvs (plugin runtimes)
**/.venv/
*.pt
