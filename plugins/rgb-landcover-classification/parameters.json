{
  "$schema": "https://aerial-analytics.local/schemas/parameters.v1.json",
  "parameters": [
    {
      "name": "model_id",
      "label": "Model",
      "type": "select",
      "options": [
        "rf_superpixel_v1",
        "deeplab_resnet101_v1"
      ],
      "default": "rf_superpixel_v1",
      "description": "Model klasifikasi yang dipakai."
    },
    {
      "name": "min_confidence",
      "label": "Minimum Confidence",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Piksel dengan confidence di bawah nilai ini tidak diklasifikasi."
    },
    {
      "name": "segment_size",
      "label": "Superpixel Segment Size",
      "type": "number",
      "default": 500,
      "min": 1,
      "step": 1,
      "description": "Parameter segmentasi superpixel untuk rf_superpixel_v1."
    },
    {
      "name": "gsd_m_per_px",
      "label": "GSD (m/px)",
      "type": "number",
      "default": 0,
      "min": 0,
      "step": 0.001,
      "description": "Meter per piksel. 0 = tidak diisi (estimasi otomatis)."
    },
    {
      "name": "device",
      "label": "Device",
      "type": "select",
      "options": [
        "auto",
        "cpu",
        "cuda"
      ],
      "default": "auto",
      "description": "Perangkat inferensi."
    },
    {
      "name": "classes_json",
      "label": "Custom Classes (JSON)",
      "type": "string",
      "default": "",
      "description": "Kosong = kelas bawaan. Isi list JSON [{id, name, color}]."
    }
  ]
}