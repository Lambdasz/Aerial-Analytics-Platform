{
  "$schema": "https://aerial-analytics.local/schemas/plugin.v1.json",
  "manifest_version": 1,
  "metadata": {
    "id": "vegetation-coverage-analytics",
    "name": "Vegetation Coverage Analytics",
    "version": "1.0.0",
    "author": "PBL Team 2026",
    "license": "MIT",
    "description": "Quantifies vegetation coverage from a binary vegetation mask: coverage percentage, vegetated area, low/medium/high classification, NxN zonation grid and per-plot comparison.",
    "category": "vegetation",
    "tags": ["rgb", "vegetation", "coverage", "zonation", "plots", "rust"],
    "min_core_version": "0.1.0"
  },
  "runtime": {
    "type": "binary",
    "entrypoint": "bin/main",
    "dependencies_file": null,
    "healthcheck_flag": "--healthcheck"
  },
  "parameters": "parameters.json",
  "inputs": "inputs.json",
  "outputs": "outputs.json",
  "execution": {
    "timeout_seconds": 120,
    "concurrency": "sequential",
    "gpu": {
      "support": "none",
      "driver": null
    }
  }
}
