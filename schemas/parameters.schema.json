{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aerial-analytics.local/schemas/parameters.v1.json",
  "title": "Plugin Parameters Specification",
  "description": "JSON Schema for validating plugin parameters and UI form controls (Module 2)",
  "type": "object",
  "required": ["parameters"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "label", "type", "default"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Parameter key passed inside parameters object of input payload"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label for UI form fields"
          },
          "description": {
            "type": "string",
            "description": "Tooltip or helper text explaining parameter effect"
          },
          "type": {
            "type": "string",
            "enum": ["number", "boolean", "select", "string"]
          },
          "default": {
            "description": "Default initial value matching parameter type"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed options list when type is 'select'"
          },
          "min": {
            "type": "number",
            "description": "Minimum limit when type is 'number'"
          },
          "max": {
            "type": "number",
            "description": "Maximum limit when type is 'number'"
          },
          "step": {
            "type": "number",
            "description": "Step increment when type is 'number'"
          }
        }
      }
    }
  }
}
