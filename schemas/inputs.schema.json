{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aerial-analytics.local/schemas/inputs.v1.json",
  "title": "Plugin Inputs Specification",
  "description": "JSON Schema for validating plugin input requirements and capabilities (Module 2)",
  "type": "object",
  "required": ["granularity", "supported_mime_types"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "granularity": {
      "type": "string",
      "enum": ["single_image", "image_pair", "batch", "session", "flight_session", "multi_image"],
      "description": "Scope of analysis executed per single invocation"
    },
    "supported_mime_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["image/jpeg", "image/png", "image/tiff", "application/x-geotiff"]
      },
      "description": "Image MIME formats accepted by the plugin"
    },
    "requires_metadata": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["resolution", "gps", "altitude", "timestamp", "camera_model"]
      },
      "description": "Mandatory image metadata keys"
    },
    "optional_metadata": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["resolution", "gps", "altitude", "timestamp", "camera_model"]
      },
      "description": "Optional image metadata keys used if present"
    },
    "supports_aoi": {
      "type": "boolean",
      "default": false,
      "description": "Whether the plugin supports clipping computation to an Area of Interest"
    },
    "aoi_format": {
      "type": "string",
      "enum": ["geojson_polygon", "geojson_bbox", "pixel_bbox", "binary_mask"],
      "description": "Geometry format for the Area of Interest"
    }
  }
}
